rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }

    function isOwner(resource) {
      return signedIn() && resource.data.ownerId == uid();
    }

    function isSelf(userId) {
      return signedIn() && userId == uid();
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.role in ['student', 'landlord']
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.suspended == false;
      allow update: if isAdmin()
        || (isSelf(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.verificationStatus == resource.data.verificationStatus
            && request.resource.data.suspended == resource.data.suspended);
      allow delete: if isAdmin();
    }

    // ---------- listings ----------
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || isOwner(resource) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.status in ['active', 'paused']
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.images.size() <= 15
        && request.resource.data.genderRule in ['boys', 'girls', 'any']
        && request.resource.data.roomType in ['single', 'shared', 'apartment', 'hostel'];
      allow update: if isAdmin()
        || (isOwner(resource)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.status in ['active', 'paused', 'removed']);
      allow delete: if isOwner(resource) || isAdmin();
    }

    // Embeddings are written by the Cloud Function (Admin SDK bypasses rules).
    match /imageEmbeddings/{listingId} {
      allow read, write: if isAdmin();
    }

    // ---------- reviews ----------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.studentId == uid()
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if signedIn() && resource.data.studentId == uid() || isAdmin();
    }

    // ---------- chats ----------
    match /chats/{chatId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && uid() in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update: if signedIn() && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow delete: if isAdmin();
      }
    }

    // ---------- visit requests ----------
    match /visitRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.studentId == uid() || resource.data.landlordId == uid() || isAdmin());
      allow create: if signedIn()
        && request.resource.data.studentId == uid()
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.studentId == uid() || resource.data.landlordId == uid() || isAdmin())
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.landlordId == resource.data.landlordId;
      allow delete: if isAdmin();
    }

    // ---------- favorites ----------
    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.studentId == uid();
      allow create: if signedIn() && request.resource.data.studentId == uid();
      allow delete: if signedIn() && resource.data.studentId == uid();
    }

    // ---------- admin moderation queue ----------
    match /flaggedQueue/{itemId} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if false; // Cloud Functions only
    }

    // ---------- universities ----------
    match /universities/{universityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
