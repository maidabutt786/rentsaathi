# ---- RentSaathi AI service ----
# auto = trained when models/image_cnn.pt exists, otherwise bootstrap
AI_MODE=auto
# Shared secret sent by Cloud Functions in the X-API-KEY header. CHANGE THIS.
AI_API_KEY=dev-local-key

MODEL_DIR=./models
DATA_DIR=./data
REPORTS_DIR=./reports

# Comma-separated list. Keep it tight in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000

EMBEDDING_BACKBONE=efficientnet_b0
# Only for offline smoke tests. Never use random weights for real moderation.
ALLOW_RANDOM_WEIGHTS=false
AI_DEVICE=cpu

IMAGE_TIMEOUT_SECONDS=8
IMAGE_MAX_BYTES=6291456
MAX_IMAGES=15

# Duplicate detection
DUPLICATE_COSINE_THRESHOLD=0.92
DUPLICATE_PHASH_THRESHOLD=0.86
DUPLICATE_FLOOR=0.72

# Score weights (classifier weight is redistributed automatically in bootstrap mode)
WEIGHT_DUPLICATE=0.45
WEIGHT_CLASSIFIER=0.35
WEIGHT_ANOMALY=0.20

SUSPICIOUS_THRESHOLD=35
HIGH_RISK_THRESHOLD=65

LOG_LEVEL=INFO
