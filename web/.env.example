# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Everything works with the Firebase Emulator Suite and these placeholder values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=rentsaathi-demo
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to true only while the Firebase Emulator Suite is running (auth 9099, firestore 8080,
# storage 9199, functions 5001). Leave false to use the bundled demo data in the browser.
VITE_USE_EMULATORS=false
VITE_FUNCTIONS_REGION=asia-south1

# Optional. Without a key the map falls back to a styled list of areas (no Google request).
VITE_GOOGLE_MAPS_API_KEY=

# AI service metrics panel (GET /metrics is public and read-only)
VITE_AI_SERVICE_URL=http://127.0.0.1:8000

# auto = use bundled demo listings when Firebase is not configured; true/false to force
VITE_DEMO_MODE=auto
VITE_DEFAULT_LOCALE=en
